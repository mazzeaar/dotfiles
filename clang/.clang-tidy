---
Checks: >
  bugprone-*,
  clang-analyzer-*,
  cppcoreguidelines-*,
  misc-*,
  modernize-*,
  performance-*, 
  portability-*,
  readability-*,
  -cppcoreguidelines-avoid-const-or-ref-datamembers,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -misc-definitions-in-headers, 
  -misc-include-cleaner, 
  -misc-no-recursion, 
  -misc-non-private-member-variable-in-classes,
  -misc-non-private-member-variables-in-classes, 
  -misc-use-anonymous-namespace, 
  -misc-use-internal-linkage,
  -misc-use-internal-linkage,
  -modernize-avoid-c-arrays, 
  -modernize-concat-nested-namespaces, 
  -modernize-loop-convert, 
  -modernize-pass-by-value, 
  -modernize-raw-string-literal, 
  -modernize-use-emplace, 
  -modernize-use-equals-default, 
  -modernize-use-equals-delete, 
  -modernize-use-nodiscard, 
  -modernize-use-override, 
  -modernize-use-trailing-return-type, 
  -performance-inefficient-string-concatenation'
  -readability-identifier-length,
  -readability-identifier-naming,
  -readability-magic-numbers,
  -readability-named-parameter

WarningsAsErrors: ''

HeaderFilterRegex: '.*'

FormatStyle: file

UseColor: true

SystemHeaders: false

CheckOptions:
  - key: modernize-use-nullptr.NullMacros
    value: 'NULL'
  - key: modernize-use-nullptr.UseNullptr
    value: 'true'

  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: camelBack
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.ParameterCase
    value: lower_case

  - key: readability-identifier-length.MinimumFunctionNameLength
    value: '1'
  - key: readability-identifier-length.MinimumVariableNameLength
    value: '1'
  - key: readability-identifier-length.MinimumParameterNameLength
    value: '1'

  - key: cppcoreguidelines-avoid-magic-numbers.IgnoreEnums
    value: 'true'
  - key: cppcoreguidelines-special-member-functions.AllowMissingMoveFunctions
    value: 'false'
  - key: cppcoreguidelines-pro-type-vararg.CheckPrintf
    value: 'true'
  - key: cppcoreguidelines-pro-type-vararg.CheckScanf
    value: 'true'
  - key: cppcoreguidelines-pro-type-const-cast.IgnoreMacros
    value: 'false'
